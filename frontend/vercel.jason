{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/(.+)\\.html",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "/(.+)\\.js",
      "dest": "/frontend/$1.js"
    },
    {
      "src": "/(.+)\\.css",
      "dest": "/frontend/$1.css"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}